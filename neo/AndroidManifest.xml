<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.tvos.neo">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <application android:label="Neo TVLauncher" android:icon="@drawable/ic_launcher" android:banner="@drawable/banner"
        android:theme="@style/HomeTheme" android:allowBackup="false" android:hardwareAccelerated="true">
        <activity android:name=".NeoHomeActivity" android:exported="true" android:launchMode="singleTask"
            android:excludeFromRecents="true" android:screenOrientation="landscape" android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density">
            <intent-filter android:priority="1000"><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" /><category android:name="android.intent.category.LEANBACK_HOME" />
                <category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".NeoRemoteInstallActivity" android:exported="false" android:screenOrientation="landscape" android:launchMode="singleTask" />
        <service android:name=".NeoInstallService" android:process=":installer" android:exported="false" />
        <receiver android:name=".NeoInstallResult" android:process=":installer" android:exported="false" />
        <service android:name=".NeoCatalogService" android:exported="false" android:process=":catalog" />
        <service android:name=".NeoWeatherService" android:exported="false" android:process=":weather" />
        <service android:name=".NeoThemeService" android:exported="false" android:process=":theme" android:isolatedProcess="true" />
        <service android:name=".NeoHomeService" android:exported="true" android:label="Neo TVLauncher - Home and app locks"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/neo_home_service" />
        </service>
        <activity android:name=".NeoScreensaverActivity" android:exported="false" android:excludeFromRecents="true" android:screenOrientation="landscape" />
        <service android:name=".NeoDreamService" android:exported="true" android:label="Neo TVLauncher Screensaver" android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter><action android:name="android.service.dreams.DreamService" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </service>
    </application>
</manifest>
